{
  "name": "travel-assistant-evals-native",
  "private": true,
  "version": "0.1.0",
  "description": "Offline and online evaluation of the travel assistant with the OpenSearch GenAI observability SDK",
  "type": "module",
  "scripts": {
    "offline": "tsx offline.ts",
    "traffic": "tsx traffic.ts",
    "online": "tsx online.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1169.0",
    "@opensearch-project/genai-observability-sdk-ts": "^0.2.0",
    "@opensearch-project/opensearch": "^2.12.0",
    "@opentelemetry/api": "~1.9.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "@opentelemetry/api": "$@opentelemetry/api"
  }
}

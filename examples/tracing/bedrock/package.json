{
  "name": "travel-assistant-bedrock",
  "private": true,
  "version": "0.1.0",
  "description": "Travel assistant on the Amazon Bedrock Converse API (AWS SDK v3), traced with the OpenSearch GenAI observability SDK",
  "type": "module",
  "scripts": {
    "start": "tsx --import ./otel.ts agent.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1169.0",
    "@opensearch-project/genai-observability-sdk-ts": "^0.2.0",
    "@opentelemetry/api": "~1.9.0",
    "@opentelemetry/instrumentation": "~0.223.0",
    "@opentelemetry/instrumentation-aws-sdk": "~0.78.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "@opentelemetry/api": "$@opentelemetry/api"
  }
}

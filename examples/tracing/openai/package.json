{
  "name": "travel-assistant-openai",
  "private": true,
  "version": "0.1.0",
  "description": "Travel assistant on the OpenAI Node SDK, traced with the OpenSearch GenAI observability SDK",
  "type": "module",
  "scripts": {
    "start": "tsx --import ./instrumentation.ts agent.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws/bedrock-token-generator": "^1.1.0",
    "@opensearch-project/genai-observability-sdk-ts": "^0.2.0",
    "@opentelemetry/api": "~1.9.0",
    "@opentelemetry/context-async-hooks": "^1.30.0",
    "@opentelemetry/instrumentation": "^0.223.0",
    "@opentelemetry/instrumentation-openai": "~0.21.0",
    "openai": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "@opentelemetry/api": "$@opentelemetry/api"
  }
}
